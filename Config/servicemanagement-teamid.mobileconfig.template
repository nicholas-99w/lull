<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Managed Login Items, Team ID variant: TEMPLATE. Scripts/make-release.sh
  replaces @TEAM_ID@ with the Team ID of a Developer ID signed build and puts
  the result in the Jamf kit as profiles/servicemanagement-teamid.mobileconfig.
  Don't upload this template as it is.

  The rules are the same as in servicemanagement.mobileconfig, plus a
  TeamIdentifier sub-key on each one. Apple's schema describes the sub-key as an
  extra condition, tested after RuleType and RuleValue match
  (mdm/profiles/com.apple.servicemanagement.yaml, release branch, checked
  2026-11-06). A launchd job or app with Lull's label or bundle ID that
  someone else signed is then not approved automatically.

  Official releases are Developer ID signed, so this is the profile to deploy
  with them (Docs/DEPLOYMENT.md). A package built without a Developer ID has
  no Team ID, so these rules don't match it: use
  servicemanagement.mobileconfig for those.
  Confirmed on a test Mac: with only this profile installed, the items are
  managed and can't be turned off.
-->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.servicemanagement</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>au.com.nickit.lull.servicemanagement-teamid.FE169D35-ED55-417C-B076-05B19DEF694C</string>
			<key>PayloadUUID</key>
			<string>FE169D35-ED55-417C-B076-05B19DEF694C</string>
			<key>PayloadDisplayName</key>
			<string>Lull background items (Team ID)</string>
			<key>Rules</key>
			<array>
				<dict>
					<key>RuleType</key>
					<string>Label</string>
					<key>RuleValue</key>
					<string>au.com.nickit.lulld</string>
					<key>TeamIdentifier</key>
					<string>@TEAM_ID@</string>
					<key>Comment</key>
					<string>Lull daemon (LaunchDaemon label)</string>
				</dict>
				<dict>
					<key>RuleType</key>
					<string>Label</string>
					<key>RuleValue</key>
					<string>au.com.nickit.lull</string>
					<key>TeamIdentifier</key>
					<string>@TEAM_ID@</string>
					<key>Comment</key>
					<string>Lull lock screen (LaunchAgent label)</string>
				</dict>
				<dict>
					<key>RuleType</key>
					<string>BundleIdentifier</string>
					<key>RuleValue</key>
					<string>au.com.nickit.lull</string>
					<key>TeamIdentifier</key>
					<string>@TEAM_ID@</string>
					<key>Comment</key>
					<string>Lull.app (also suppresses the macOS 26 'keep running?' prompt)</string>
				</dict>
				<dict>
					<key>RuleType</key>
					<string>BundleIdentifier</string>
					<key>RuleValue</key>
					<string>au.com.nickit.lulld</string>
					<key>TeamIdentifier</key>
					<string>@TEAM_ID@</string>
					<key>Comment</key>
					<string>lulld signing identifier</string>
				</dict>
			</array>
		</dict>
	</array>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadIdentifier</key>
	<string>au.com.nickit.lull.servicemanagement-teamid-profile.50EA0F80-8CF3-4C36-A406-A11A75758E95</string>
	<key>PayloadUUID</key>
	<string>50EA0F80-8CF3-4C36-A406-A11A75758E95</string>
	<key>PayloadDisplayName</key>
	<string>Lull: managed login items (Team ID)</string>
	<key>PayloadDescription</key>
	<string>Stops users turning Lull off in System Settings &gt; General &gt; Login Items.</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadRemovalDisallowed</key>
	<true/>
</dict>
</plist>
